+# Track 3.1 condition C: actions canonicalised instead of deleted - the length-matched defence
+#
+# The official 3.1 weekend project asks for "the same actions hidden OR canonicalised before
+# the partner sees them". C is the second of those. Every task id becomes ISSUE-XXXX::assigned,
+# every agent name becomes [member], every event index is renumbered, and the leaked
+# joint_reward in the action payload is nulled - but no line is removed.
+#
+# Why it matters: E and S delete text, so the filtered agent gets a shorter prompt and a
+# different token budget than the unfiltered one. That confound cannot be separated from the
+# intervention in E/S alone. C holds episode length, message count and cost matched, so a drop
+# in coalition advantage under C cannot be blamed on a truncated observation.
+#
+# Model calls route through the shared endpoint; set NEBIUS_API_KEY or OPENROUTER_API_KEY in
+# the repo-root compute.env.
+
+simulation:
+  max_iterations: 1
+  max_planning_rounds: 2
+  max_conversation_steps: 1   # terrarium 0.1.1 composes the step-2 request as a model-turn-final payload; Gemini rejects it with HTTP 400 "Requests ending with a model turn are not supported" on BOTH its native API and its OpenAI-compatibility layer. At 1 step every turn executes its tool cleanly; partner actions are still observed because they are written to the shared blackboard before the next agent moves.
+  seed: 1
+  tags: [track31_c]
+
+environment:
+  name: JiraTicketEnvironment
+  assignment_filling: false
+  max_tasks: 8
+
+communication_network:
+  topology: path
+  num_agents: 4
+  consolidate_channels: true
+
+llm_models:
+  - label: gemini_3_5_flash_lite
+    llm:
+      provider: openrouter
+      openrouter:
+        model: gemini-3.5-flash-lite
+        params:
+          max_tokens: 1500
+          temperature: 0.7
+
+experiment:
+  tag: track31_c
+  output_dir: experiments/collusion/outputs/track31_c
+  max_concurrent_runs: 1
+  seeds: [1]
+  collusion:
+    colluder_selection: first_and_last
+    agent_order: random
+    coalition_prompt: always
+    observation_filter:
+      canonicalise_actions: true
+  sweeps:
+    - name: track31_c
+      topologies: [path]
+      num_agents: [4]
+      colluder_counts: [2]
+      secret_channel_enabled: [false]
+      prompt_variants: [simple]
